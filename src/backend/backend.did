type AIVerificationAsset = record {
  sha256 : text;
  content_type : text;
  step_index : nat64;
  s3_url : text;
  asset_id : text;
};
type AIVerificationResult = record {
  status : VerificationStatus;
  evidence_urls : vec text;
  model_version : text;
  session_id : text;
  breakdown : vec record { text; float64 };
  assets : vec AIVerificationAsset;
  created_at : nat64;
  anomaly_count : nat32;
  final_score : float64;
  base_similarity : float64;
  notes : vec text;
  checked_at : nat64;
  verification_id : text;
};
type Account = record { owner : principal; subaccount : opt blob };
type Certificate = record {
  nft_id : opt text;
  authenticity_rating : nat32;
  username : text;
  verification_score : nat32;
  session_id : text;
  verification_url : text;
  metadata : CertificateMetadata;
  art_title : text;
  description : text;
  blockchain_tx : text;
  community_trust : nat32;
  issuer : text;
  nft_generated : bool;
  blockchain : text;
  expiry_date : nat64;
  token_standard : text;
  verification_hash : text;
  issue_date : nat64;
  qr_code_data : text;
  token_uri : opt text;
  certificate_type : text;
  certificate_id : text;
  provenance_score : nat32;
  certificate_status : text;
};
type CertificateMetadata = record {
  file_format : text;
  creation_duration : text;
  file_size : text;
  creation_tools : vec text;
  total_actions : nat32;
};
type ChartDataPoint = record {
  certificates_created : nat64;
  sessions_completed : nat64;
  date : text;
  portfolio_value : float64;
};
type CollectionMetadata = record {
  name : text;
  description : opt text;
  max_supply : opt nat64;
  image : opt text;
  total_supply : nat64;
};
type Coupon = record {
  max_uses : nat32;
  code : text;
  coupon_type : CouponType;
  current_uses : nat32;
  is_active : bool;
  expires_at : nat64;
};
type CouponType = variant { Premium; Enterprise; Free; Basic };
type CreateCertificateRequest = record {
  username : text;
  file_sizes : vec nat64;
  session_id : text;
  photo_count : nat32;
  file_format : text;
  art_title : text;
  creation_duration : nat32;
  description : text;
  creation_tools : vec text;
};
type DashboardMetrics = record {
  total_sessions : nat64;
  total_users : nat64;
  total_certificates : nat64;
};
type LoginResult = record {
  username : opt text;
  message : text;
  success : bool;
};
type NFTGenerationResult = record { nft_id : text; token_uri : text };
type PhysicalArtSession = record {
  status : text;
  updated_at : nat64;
  uploaded_photos : vec text;
  username : text;
  session_id : text;
  art_title : text;
  description : text;
  created_at : nat64;
};
type ProfileUpdateResult = record {
  message : text;
  updated_fields : vec text;
  success : bool;
};
type Result = variant { Ok : bool; Err : text };
type Result_1 = variant { Ok : text; Err : text };
type Result_2 = variant { Ok : Certificate; Err : text };
type Result_3 = variant { Ok : NFTGenerationResult; Err : text };
type Result_4 = variant { Ok; Err : text };
type Result_5 = variant { Ok : nat64; Err : text };
type Result_6 = variant { Ok : VerificationResult; Err : text };
type S3Config = record {
  region : text;
  endpoint : opt text;
  secret_access_key : text;
  bucket_name : text;
  access_key_id : text;
};
type SubscriptionLimits = record {
  priority_support : bool;
  can_generate_nft : bool;
  max_file_size_mb : nat32;
  max_photos : nat32;
};
type Token = record {
  id : nat64;
  session_id : opt text;
  owner : Account;
  metadata : TokenMetadata;
  created_at : nat64;
};
type TokenAttribute = record { trait_type : text; value : text };
type TokenMetadata = record {
  name : text;
  description : opt text;
  attributes : vec TokenAttribute;
  image : opt text;
};
type TransferRequest = record {
  to : Account;
  token_id : nat64;
  from : Account;
  memo : opt blob;
  created_at_time : opt nat64;
};
type TransferResponse = record { result : Result_4; token_id : nat64 };
type UpdateProfileRequest = record {
  bio : opt text;
  email : opt text;
  display_name : opt text;
  location : opt text;
};
type UploadFileData = record {
  content_type : text;
  file_size : nat64;
  filename : text;
};
type User = record {
  bio : opt text;
  password_hash : text;
  updated_at : nat64;
  username : text;
  avatar_url : opt text;
  created_at : nat64;
  email : opt text;
  display_name : opt text;
  subscription_tier : text;
  location : opt text;
};
type UserActivity = record {
  id : text;
  status : text;
  activity_type : text;
  title : text;
  metadata : text;
  description : text;
  timestamp : nat64;
};
type UserChartData = record { period : text; data : vec ChartDataPoint };
type UserDashboardData = record {
  metrics : UserDashboardMetrics;
  recent_activities : vec UserActivity;
  chart_data : UserChartData;
  performance_stats : UserPerformanceStats;
};
type UserDashboardMetrics = record {
  total_sessions : nat64;
  certificates_created : nat64;
  active_sessions : nat64;
  nfts_owned : nat64;
  portfolio_growth_percentage : float64;
  portfolio_value_icp : float64;
};
type UserPerformanceStats = record {
  avg_verification_score : float64;
  success_rate : float64;
  top_artwork : text;
  total_uploads : nat64;
};
type VerificationResult = record {
  valid : bool;
  score : nat32;
  details : text;
};
type VerificationStatus = variant { Rejected; ReviewNeeded; Verified; Pending };
type VerificationUpdateRequest = record {
  status : VerificationStatus;
  evidence_urls : vec text;
  breakdown : vec record { text; float64 };
  anomaly_count : nat32;
  final_score : float64;
  base_similarity : float64;
  notes : vec text;
  verification_id : text;
};
service : () -> {
  check_username_availability : (text) -> (bool) query;
  configure_s3 : (S3Config) -> (bool);
  create_coupon : (text, CouponType, nat32, nat64) -> (Result);
  create_physical_art_session : (text, text, text) -> (Result_1);
  create_verification_request : (text, vec text) -> (Result_1);
  delete_verification_asset : (text, text) -> (Result);
  generate_certificate : (CreateCertificateRequest) -> (Result_2);
  generate_nft_for_certificate : (text) -> (Result_3);
  generate_upload_url : (text, UploadFileData) -> (Result_1);
  get_all_subscriptions_debug : () -> (vec record { text; CouponType }) query;
  get_all_users : () -> (vec text) query;
  get_available_coupons : () -> (vec Coupon) query;
  get_certificate_by_id : (text) -> (opt Certificate) query;
  get_certificate_count : () -> (nat64) query;
  get_certificate_for_nft_minting : (text) -> (opt Certificate) query;
  get_certificate_nft_metadata : (text) -> (opt text) query;
  get_dashboard_metrics : () -> (DashboardMetrics) query;
  get_nft_metadata : (text) -> (opt text) query;
  get_pending_verifications : () -> (vec AIVerificationResult) query;
  get_recent_sessions : (nat64) -> (vec PhysicalArtSession) query;
  get_s3_config : () -> (opt S3Config) query;
  get_s3_config_status : () -> (bool) query;
  get_session_count : () -> (nat64) query;
  get_session_details : (text) -> (opt PhysicalArtSession) query;
  get_session_nfts : (text) -> (vec Token) query;
  get_session_verifications : (text) -> (vec AIVerificationResult) query;
  get_subscription_limits : (text) -> (opt SubscriptionLimits) query;
  get_token_details : (nat64) -> (opt Token) query;
  get_user_activity_timeline : (text, nat64) -> (vec UserActivity) query;
  get_user_avatar : (text) -> (opt text) query;
  get_user_certificates : (text) -> (vec Certificate) query;
  get_user_chart_data : (text, text) -> (opt UserChartData) query;
  get_user_count : () -> (nat64) query;
  get_user_dashboard_data : (text) -> (opt UserDashboardData) query;
  get_user_dashboard_metrics : (text) -> (opt UserDashboardMetrics) query;
  get_user_info : (text) -> (opt record { text; nat64 }) query;
  get_user_nfts : (principal) -> (vec Token) query;
  get_user_performance_stats : (text) -> (opt UserPerformanceStats) query;
  get_user_profile : (text) -> (opt User) query;
  get_user_sessions : (text) -> (vec PhysicalArtSession) query;
  get_user_subscription : (text) -> (opt CouponType) query;
  get_user_subscription_debug : (text) -> (opt CouponType) query;
  get_verification_result : (text) -> (opt AIVerificationResult) query;
  get_verification_stats : () -> (nat64, nat64, nat64, nat64) query;
  icrc7_balance_of : (vec Account) -> (vec nat64) query;
  icrc7_collection_metadata : () -> (CollectionMetadata) query;
  icrc7_description : () -> (opt text) query;
  icrc7_name : () -> (text) query;
  icrc7_owner_of : (vec nat64) -> (vec opt Account) query;
  icrc7_supply_cap : () -> (opt nat64) query;
  icrc7_token_metadata : (vec nat64) -> (vec opt TokenMetadata) query;
  icrc7_tokens : (opt nat64, opt nat64) -> (vec nat64) query;
  icrc7_tokens_of : (Account, opt nat64, opt nat64) -> (vec nat64) query;
  icrc7_total_supply : () -> (nat64) query;
  icrc7_transfer : (vec TransferRequest) -> (vec TransferResponse);
  initialize_demo_coupons : () -> (Result);
  initialize_user_subscription : (text) -> (Result);
  login : (text, text) -> (LoginResult);
  manual_verification_override : (
      text,
      VerificationStatus,
      text,
      opt float64,
    ) -> (Result);
  mint_certificate_nft : (text, Account) -> (Result_5);
  mint_nft_from_session : (text, Account, vec record { text; text }) -> (
      Result_5,
    );
  redeem_coupon : (text, text) -> (Result);
  register_user : (text, text) -> (LoginResult);
  remove_photo_from_session : (text, text) -> (Result);
  set_s3_config : (S3Config) -> (bool);
  set_user_subscription : (text, CouponType) -> (Result);
  update_certificate_nft_info : (text, text, text) -> (Result);
  update_collection_metadata : (text, opt text, opt text, opt nat64) -> (
      Result,
    );
  update_display_name : (text, text, text) -> (LoginResult);
  update_session_status : (text, text) -> (Result);
  update_user_avatar : (text, text) -> (Result);
  update_user_profile : (text, text, UpdateProfileRequest) -> (
      ProfileUpdateResult,
    );
  update_user_subscription : (text, CouponType) -> (Result);
  update_username : (text, text, text) -> (LoginResult);
  update_verification_result : (VerificationUpdateRequest) -> (Result);
  upload_photo_to_session : (text, text) -> (Result);
  verify_certificate : (text) -> (Result_6);
}
